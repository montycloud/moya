# Copy this file to .env and fill in your values before running docker compose.

# OpenAI API key (required for openai-provider agents in Real mode)
OPENAI_API_KEY=

# Ollama URL — if Ollama is running on your host machine use these:
#   Mac / Windows:  http://host.docker.internal:11434
#   Linux:          http://172.17.0.1:11434
OLLAMA_URL=http://host.docker.internal:11434
