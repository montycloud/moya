FROM python:3.12-slim

WORKDIR /app

# Copy the local moya source tree (needed at runtime)
COPY moya/ /app/moya/
COPY pyproject.toml /app/

# Install the local moya package in editable mode
RUN pip install --no-cache-dir -e /app

# Install backend dependencies
COPY moya-ui/backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

COPY moya-ui/backend/ /app/backend/

WORKDIR /app/backend

ENV PYTHONPATH=/app

EXPOSE 8000

CMD ["python3", "main.py"]
